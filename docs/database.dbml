// ============================================================
// AUTH
// ============================================================

Enum oauth_provider {
  google
  github
}

// Auth methods (at least one must be set):
//   - Email/password: password_hash is set
//   - OAuth: oauth_provider AND oauth_provider_account_id are both set
// Enforce in raw SQL with a CHECK constraint:
//   CHECK (
//     password_hash IS NOT NULL
//     OR (oauth_provider IS NOT NULL AND oauth_provider_account_id IS NOT NULL)
//   )
// And the both-or-neither invariant on the OAuth pair:
//   CHECK (
//     (oauth_provider IS NULL AND oauth_provider_account_id IS NULL)
//     OR (oauth_provider IS NOT NULL AND oauth_provider_account_id IS NOT NULL)
//   )
Table users {
  id uuid [pk]
  email varchar [unique, not null]
  password_hash varchar [note: 'nullable for OAuth-only users']

  oauth_provider oauth_provider
  oauth_provider_account_id varchar

  name varchar
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    // Same OAuth identity cannot be linked to two different users
    (oauth_provider, oauth_provider_account_id) [unique]
  }
}

// ============================================================
// JOB HUNT
// ============================================================

Enum hunt_status {
  active
  ended
}

Table job_hunts {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  name varchar [not null]
  status hunt_status [not null, default: 'active']
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    // Partial unique index to enforce "one active hunt per user".
    // In raw SQL: CREATE UNIQUE INDEX ... ON job_hunts(user_id) WHERE status = 'active'
    (user_id) [unique, name: 'one_active_hunt_per_user', note: 'partial: WHERE status = active']
  }
}

// ============================================================
// APPLICATION
// ============================================================

// Top-level board stages. Rendered as columns in the UI, but they are stages.
Enum board_stage {
  applied
  active
  final_stages
  closed
}

Enum closed_outcome {
  rejected
  withdrawn
  accepted
  ghosted
}

Enum application_source {
  linkedin
  itviec
  referral
  direct
  recruiter
  other
}

Enum working_model {
  remote
  hybrid
  onsite
}

// User-configurable sub-stages (HR screen, tech screen, onsite, etc.)
Table sub_stages {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  name varchar [not null]
  stage board_stage [not null, note: 'which board stage this sub-stage belongs to']
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, stage, name) [unique]
  }
}

Table applications {
  id uuid [pk]
  job_hunt_id uuid [ref: > job_hunts.id, not null]
  company varchar [not null]
  role varchar [not null]

  // Board position
  stage board_stage [not null, default: 'applied']
  sub_stage_id uuid [ref: > sub_stages.id]

  // Optional metadata (all nullable on purpose)
  source application_source
  jd_url varchar
  jd_text text [note: 'fallback if posting gets taken down']
  location varchar
  working_model working_model
  salary_min int
  salary_max int
  salary_currency varchar
  notes text

  // Resume used for this application
  resume_id uuid [ref: > resumes.id]

  // Closed-state details
  closed_outcome closed_outcome [note: 'must be NULL when stage != closed; must be set when stage = closed']
  closed_at timestamptz [note: 'must be NULL when stage != closed; must be set when stage = closed']

  applied_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    job_hunt_id
    (job_hunt_id, stage)
  }
}

// Free-form filter tags (frontend, remote, startup, etc.) - user-owned, reusable
Table tags {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  name varchar [not null]
  color varchar
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, name) [unique]
  }
}

Table application_tags {
  application_id uuid [ref: > applications.id]
  tag_id uuid [ref: > tags.id]

  indexes {
    (application_id, tag_id) [pk]
  }
}

// ============================================================
// RESUME
// ============================================================

Enum resume_scope {
  library
  application
}

// Scope rules:
//   scope = 'library'     + application_id IS NULL  -> shows in picker, reusable across apps
//   scope = 'application' + application_id = <id>   -> hidden from picker, one-off for that app
// Promote a one-off to the library:
//   UPDATE resumes SET scope = 'library', application_id = NULL WHERE id = ?
// Invariant: (scope = 'library') <=> (application_id IS NULL)
// Enforce in raw SQL with a CHECK constraint:
//   CHECK ((scope = 'library' AND application_id IS NULL)
//       OR (scope = 'application' AND application_id IS NOT NULL))
Table resumes {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  name varchar [not null]
  scope resume_scope [not null]
  application_id uuid [ref: > applications.id, note: 'set if scope = application; see scope rules above']

  file_url varchar [not null, note: 'object storage path/key']
  file_size_bytes bigint
  mime_type varchar
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, scope)
    application_id
  }
}

// ============================================================
// EVENTS (future-dated: interviews, take-homes, deadlines)
// ============================================================

Enum event_type {
  hr_screen
  tech_screen
  onsite
  take_home_due
  offer_deadline
  other
}

Enum event_status {
  scheduled
  completed
  cancelled
}

Table events {
  id uuid [pk]
  application_id uuid [ref: > applications.id, not null]
  type event_type [not null]
  title varchar
  scheduled_at timestamptz [not null]
  duration_minutes int
  location varchar [note: 'address or video link']
  notes text
  status event_status [not null, default: 'scheduled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    application_id
    scheduled_at
  }
}

// ============================================================
// ACTIVITY LOG
// ============================================================

Enum activity_type {
  created
  stage_change
  sub_stage_change
  note_added
  response_received
  event_scheduled
  event_completed
  event_cancelled
  resume_changed
  closed
}

Table activity_log {
  id uuid [pk]
  application_id uuid [ref: > applications.id, not null]
  type activity_type [not null]
  description text
  // Structured payload for diffs: { from: 'applied', to: 'active' }, etc.
  // Keeps the table generic without needing a column per activity flavor.
  metadata jsonb
  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, occurred_at)
  }
}

// ============================================================
// NOTIFICATION ENGINE (shared for action-needed + time-based)
// ============================================================

Enum rule_kind {
  condition  // action-needed (state-based)
  time_based // reminders (event-based)
}

Table notification_rules {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  name varchar [not null]
  kind rule_kind [not null]
  enabled boolean [not null, default: true]

  // Flexible config so we don't need a new column per rule variant.
  // condition example:  { when: { stage: 'applied', idle_days_gte: 14 } }
  // time_based example: { when: { event_type: 'interview', offset_days: -3 } }
  trigger_config jsonb [not null]
  // delivery prefs override (channels, quiet hours), optional
  action_config jsonb

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, kind)
  }
}

Enum notification_status {
  unread
  read
  snoozed
  dismissed
}

// dedup_key prevents the same logical notification from firing repeatedly.
// The rule engine builds it deterministically from rule + target + time bucket.
// Examples:
//   condition (idle 14d):  "rule:<rule_id>|app:<application_id>|bucket:2026-W21"
//   time_based (T-3 days): "rule:<rule_id>|event:<event_id>|offset:-3d"
// Unique per user so the same key from two users does not collide.
Table notifications {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  rule_id uuid [ref: > notification_rules.id]
  // At most one of these is set; both nullable.
  application_id uuid [ref: > applications.id]
  event_id uuid [ref: > events.id]

  title varchar [not null]
  content text
  status notification_status [not null, default: 'unread']
  snoozed_until timestamptz

  dedup_key varchar [not null, note: 'see comment above table for format']

  created_at timestamptz [not null, default: `now()`]
  read_at timestamptz

  indexes {
    (user_id, status, created_at)
    (user_id, dedup_key) [unique, note: 'engine relies on this for upsert/no-op on re-fire']
  }
}

Table user_notification_prefs {
  user_id uuid [pk, ref: > users.id]
  in_app_enabled boolean [not null, default: true]
  email_digest_enabled boolean [not null, default: false]
  email_digest_cadence varchar [note: 'daily | weekly']
  quiet_hours_start time
  quiet_hours_end time
  timezone varchar
}

