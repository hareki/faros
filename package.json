{
  "name": "faros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "tsc",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "cleanup": "pnpm typecheck && pnpm fmt && pnpm lint",
    "inngest:dev": "inngest-cli dev --port 3001",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun app/db/seed.ts",
    "intl:generate": "NODE_ENV=production bun scripts/generateNextIntlTypes.ts",
    "email:dev": "pnpm --filter @faros/emails dev --port 3002"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/react": "^0.4.0",
    "@epic-web/remember": "^1.1.0",
    "@faros/emails": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@lexical/react": "^0.45.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "16.2.6",
    "@react-email/render": "2.0.8",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.44.0",
    "@teispace/next-themes": "^2.0.1",
    "better-auth": "^1.6.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "inngest": "^4.5.0",
    "lexical": "^0.45.0",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "nuqs": "^2.8.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "shadcn": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-naming-convention": "^5.8.8",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "inngest-cli": "^1.23.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "tailwindcss": "^4.3.0",
    "ts-xor": "^1.3.0",
    "typescript": "^6.0.3"
  }
