{
  "name": "faros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "tsc",
    "fallow": "fallow",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "cleanup": "pnpm typecheck && pnpm fmt && pnpm lint",
    "inngest:dev": "inngest-cli dev --port 3001",
    "db:generate": "drizzle-kit generate",
    "db:migrate:test": "NODE_ENV=test drizzle-kit migrate",
    "db:migrate:dev": "NODE_ENV=development drizzle-kit migrate",
    "db:migrate:prod": "NODE_ENV=production drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun app/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:generate": "NODE_ENV=production bun scripts/generateNextIntlTypes.ts",
    "i18n:check": "i18n-check -l app/lib/next-intl/messages --source en-US --format next-intl && bun scripts/checkMessageStructure.ts",
    "email:dev": "pnpm --filter @faros/emails dev --port 3002"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@dnd-kit/react": "^0.5.0",
    "@epic-web/remember": "^1.1.0",
    "@faros/emails": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@lexical/react": "^0.45.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "16.2.9",
    "@react-email/render": "^2.0.8",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.44.0",
    "@teispace/next-themes": "^2.0.2",
    "better-auth": "^1.6.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "husky": "^9.1.7",
    "inngest": "^4.5.1",
    "lexical": "^0.45.0",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "nuqs": "^2.8.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.78.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@lingual/i18n-check": "^0.9.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-naming-convention": "^5.8.18",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "^2.94.0",
    "inngest-cli": "^1.27.0",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "tailwindcss": "^4.3.0",
    "ts-xor": "^1.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc}": [
      "oxfmt --write"
    ]
  },
  "commitlint": {
    "rules": {
      "header-max-length": [
        2,
        "always",
        100
      ],
      "subject-case": [
        2,
        "never",
        [
          "sentence-case",
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "subject-empty": [
        2,
        "never"
      ],
      "type-case": [
        2,
        "always",
        "lower-case"
      ],
      "type-empty": [
        2,
        "never"
      ],
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "revert",
          "enhance"
        ]
      ]
    }
  },
  "packageManager": "pnpm@11.6.0"
}
